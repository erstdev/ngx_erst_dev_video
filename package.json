{
  "name": "ngx-erst-dev-video",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx serve demo",
    "build": "nx build demo",
    "build:all": "nx run-many --target=build --all",
    "lint": "nx run-many --target=lint --all",
    "lint:all": "nx run-many --target=lint --all",
    "affected:build": "nx affected --target=build",
    "affected:lint": "nx affected --target=lint",
    "lint:fix": "nx run-many --target=lint --all --fix",
    "lint-staged:fix": "lint-staged --relative",
    "format:check": "nx format:check",
    "format:write": "nx format:write",
    "verify": "nx run-many --target=lint,build --all",
    "verify:affected": "nx affected --target=lint,build",
    "prepare": "husky",
    "postinstall": "patch-package"
  },
  "lint-staged": {
    "*.{ts,js,html,scss}": [
      "nx affected --target=lint --fix --files"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "~22.3.0",
    "@angular/compiler": "~22.3.0",
    "@angular/core": "~22.3.0",
    "@angular/forms": "~22.3.0",
    "@angular/platform-browser": "~22.3.0",
    "@angular/router": "~22.3.0",
    "rxjs": "~7.8.2"
  },
  "devDependencies": {
    "@angular-devkit/core": "~22.3.0",
    "@angular-devkit/schematics": "~22.3.0",
    "@angular/build": "~22.3.0",
    "@angular/cli": "~22.3.0",
    "@angular/compiler-cli": "~22.3.0",
    "@angular/language-service": "~22.3.0",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "24.1.0-beta.2",
    "@nx/eslint": "24.1.0-beta.2",
    "@nx/eslint-plugin": "24.1.0-beta.2",
    "@nx/js": "24.1.0-beta.2",
    "@nx/web": "24.1.0-beta.2",
    "@nx/workspace": "24.1.0-beta.2",
    "@schematics/angular": "~22.3.0",
    "@swc/helpers": "~0.5.24",
    "@typescript-eslint/utils": "^8.73.0",
    "angular-eslint": "^22.8.0",
    "autoprefixer": "^10.7.0",
    "dashjs": "^5.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "hls.js": "^1.7.4",
    "husky": "^9.1.7",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^17.6.1",
    "ng-packagr": "~22.3.0",
    "nx": "24.1.0-beta.2",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.33",
    "prettier": "~3.10.1",
    "tslib": "^2.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
