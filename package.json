{
  "name": "ngx-erst-dev-video",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx serve demo",
    "build": "nx build demo",
    "build:all": "nx run-many --target=build --all",
    "lint": "nx run-many --target=lint --all",
    "lint:all": "nx run-many --target=lint --all",
    "affected:build": "nx affected --target=build",
    "affected:lint": "nx affected --target=lint",
    "lint:fix": "nx run-many --target=lint --all --fix",
    "lint-staged:fix": "lint-staged --relative",
    "format:check": "nx format:check",
    "format:write": "nx format:write",
    "verify": "nx run-many --target=lint,build --all",
    "verify:affected": "nx affected --target=lint,build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,html,scss}": [
      "nx affected --target=lint --fix --files"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "~22.1.0",
    "@angular/compiler": "~22.1.0",
    "@angular/core": "~22.1.0",
    "@angular/forms": "~22.1.0",
    "@angular/platform-browser": "~22.1.0",
    "@angular/router": "~22.1.0",
    "rxjs": "~7.8.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "~22.1.0",
    "@angular-devkit/schematics": "~22.1.0",
    "@angular/build": "~22.1.0",
    "@angular/cli": "~22.1.0",
    "@angular/compiler-cli": "~22.1.0",
    "@angular/language-service": "~22.1.0",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/web": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@schematics/angular": "~22.1.0",
    "@swc/helpers": "~0.5.18",
    "@typescript-eslint/utils": "^8.58.0",
    "angular-eslint": "^22.1.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.7",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^17.6.0",
    "ng-packagr": "~22.1.0",
    "nx": "23.2.1",
    "postcss": "^8.4.5",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0"
  }
}
