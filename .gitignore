# =============================================================================
# ngx-erst-dev-video — правила игнорирования Git
# =============================================================================

# --- Зависимости -------------------------------------------------------------
/node_modules/

# --- Артефакты сборки --------------------------------------------------------
/dist
/tmp
/out-tsc
*.tsbuildinfo

# Сгенерированная документация сайта (tools/docs/generate.mjs)
/apps/demo/public/docs-content/

# --- Кеши Nx и Angular -------------------------------------------------------
.nx/cache
.nx/workspace-data
.nx/migrate-runs
/.angular

# --- Логи --------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Переменные окружения -----------------------------------------------------
.env
.env.*
!.env.example

# --- Редакторы и IDE ----------------------------------------------------------
.idea/
.vscode/
*.iml

# --- Операционная система ------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# --- Прочее ----------------------------------------------------------------------
.eslintcache
.claude/worktrees
.claude/settings.local.json

# Личный рабочий файл-«сейв» проекта (раздел 9 CONTEXT.md). Уберите строку,
# если хотите версионировать документ.
CONTEXT.md
